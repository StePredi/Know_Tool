/* Formulario: tutte le formule in una pagina */
.fo-bar { display: flex; gap: 10px; align-items: center; margin: 8px 0 12px; }
.fo-vuoto { color: var(--mute); }
.fo-wrap { columns: 3 320px; column-gap: 14px; }
.fo-ramo { break-inside: avoid; background: var(--surface); border: 2px solid var(--c); border-radius: 14px; margin: 0 0 14px; overflow: hidden; }
.fo-ramo h2 { margin: 0; padding: 6px 12px; background: var(--c); color: #fff; font-size: 15px; display: flex; gap: 8px; align-items: center; }
.fo-ramo h2 i { font-style: normal; background: rgba(255,255,255,.3); border-radius: 999px; min-width: 22px; height: 22px; display: grid; place-items: center; font-size: 12px; }
.fo-r { border-top: 1px solid var(--line); }
.fo-r:first-of-type { border-top: 0; }
.fo-b { display: block; width: 100%; text-align: left; border: 0; background: none; color: inherit; font: inherit; padding: 7px 12px; cursor: pointer; }
.fo-b:hover { background: var(--surface2); }
.fo-n { font-weight: 700; font-size: 14px; display: block; }
.fo-f { font-size: 18px; display: block; margin-top: 1px; overflow-x: auto; }
.fo-v { display: block; color: var(--mute); font-size: 13.5px; }
.fo-più { padding: 0 12px 10px; font-size: 13.5px; }
.fo-più ul { margin: 2px 0 6px; padding-left: 18px; }
.fo-ex { background: var(--surface2); border-radius: 8px; padding: 4px 8px; margin: 4px 0; }
.fo-er { background: #fff1c7; color: #6b4a00; border-radius: 8px; padding: 4px 8px; margin: 4px 0 8px; }
@media print {
  body * { visibility: hidden; }
  .fo, .fo * { visibility: visible; }
  .fo { position: absolute; left: 0; top: 0; width: 100%; }
  .fo-bar, .fo-più { display: none; }
  .fo-wrap { columns: 3; }
  .fo-b { padding: 3px 8px; }
  .fo-f { font-size: 14px; }
}
.fo-fl { display: block; }
